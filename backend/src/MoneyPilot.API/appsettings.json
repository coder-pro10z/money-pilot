{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "MoneyPilotAPI",
    "Audience": "MoneyPilotUsers",
    "ExpiresInMinutes": 60
  },

  "RecurringTransactionProcessing": {
    "Enabled": true,
    "ProcessingTime": "02:00:00",
    "RetryCount": 3,
    "RetryDelaySeconds": 60,
    "RunOnStartup": true
  }
}